<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>KillTimeTracker</AssemblyName>
    <RootNamespace>KillTimeTracker</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <PublishDir>$(MSBuildThisFileDirectory)build/publish/KillTimeTracker/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SwiftlyS2.CS2" Version="*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="resources/translations/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CreateReleaseZip" AfterTargets="Publish">
    <PropertyGroup>
      <ReleaseDir>$(MSBuildThisFileDirectory)Release</ReleaseDir>
      <ReleaseZip>$(ReleaseDir)\KillTimeTracker-$(Version).zip</ReleaseZip>
    </PropertyGroup>

    <RemoveDir Directories="$(ReleaseDir)" />
    <MakeDir Directories="$(ReleaseDir)" />

    <ZipDirectory
      SourceDirectory="$(PublishDir)"
      DestinationFile="$(ReleaseZip)"
      Overwrite="true" />

    <Message Text="Release zip created: $(ReleaseZip)" Importance="high" />
  </Target>

</Project>
